# Copia este archivo como .env (o pon estas variables en tu hosting).

# Dirección pública HTTPS de la app (sin barra final). Obligatoria para el iPhone y para Meta.
PUBLIC_URL=https://luzdelnorte-redes.netlify.app

# Contraseña para abrir la app (elige una larga). NO es la de Instagram ni la de Facebook.
APP_PASSWORD=cambia-esta-contraseña-por-una-larga

# Carpeta donde se guardan fotos y datos (en Docker/Railway: un volumen persistente).
DATA_DIR=/data

# Puerto interno
PORT=3000

# Zona horaria del fotógrafo
TZ_APP=Europe/Madrid

# App de Meta (developers.facebook.com → tu app → Configuración → Básica)
META_APP_ID=
META_APP_SECRET=
# Opcional: solo si usas "Inicio de sesión con Facebook para empresas" (configuración con ID)
META_CONFIG_ID=
# Versión de la Graph API
META_GRAPH_VERSION=v26.0

# Remitente de las notificaciones push (un email de contacto)
VAPID_SUBJECT=mailto:info@luzdelnortefotografia.com

# Pon 1 para probar sin publicar de verdad
DEMO_MODE=0
